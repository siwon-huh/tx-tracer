{
  "name": "tx-tracer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && tsc --project server/tsconfig.json && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check:live": "tsx scripts/check-live.ts",
    "update:chains": "tsx scripts/update-chain-catalog.ts",
    "update:logos": "tsx scripts/update-logos.ts",
    "check:vercel": "node scripts/check-vercel-build.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.1",
    "@xyflow/react": "^12.8.5",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.57.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
