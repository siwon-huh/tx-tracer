# Optional. All queries stay read-only. Never put secrets in VITE_* variables.
PORT=4317
HOST=127.0.0.1
LIFI_API_KEY=
ETHERSCAN_API_KEY=
# Optional bearer token for the documented rhino.fi history API.
RHINO_API_KEY=
# Optional. Configure BOTH values for a shared per-IP limit across Vercel instances.
# Leave both empty to use the instance-local limit without an external database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
